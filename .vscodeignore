# Local state, generated archives, and package artifacts.
.gitignore
exts.txt
$null
.harmony/**
.harmony-archive/**
.harmony.bak/**
.harmony-staging/**
.harmony-repair/**
.fastembed_cache/**
**/*.md
!README.md
!README.zh-CN.md
# Shipped documentation guides.
docs/*.md
!docs/LIFELINE.md
!docs/LIFELINE.zh-CN.md
!docs/provider-model-discovery.md
docs/primitives/**
docs/test.pdf
test/*.pdf
out/*.md
_*/**
*_000/
*.zip
*.vsix
*.vsix.bak
_test_extract*/**
_extract_*/**
_temp_extract_*/**

# Secrets and local config.
.env
.env.*
*.env
*.key
*.pem
*.pfx
*.p12
*.crt
*.cer

# Local development folders.
extension/
.github/

# Dev/test scripts and specs.
scripts/**
spec/**

# Runtime OCR helper script.
!scripts/ocr_text.py

# Generated dependencies/build outputs.
companion-extensions/**
native-ui/node_modules/**
native-ui/dist/**
native-ui/src-tauri/target/**

# Native build artifacts and source.
**/*.pdb
**/*.iobj
**/*.ipdb
**/*.obj
**/*.lib
**/*.exp
**/*.map
node_modules/better-sqlite3/deps/**
node_modules/duckdb/src/**

# Backups and scratch files.
_*.js
*.backup*
**/*.backup*
*.bak
**/*.bak
*.draft.*
**/*.draft.*
*.verify.*
**/*.verify.*
*.sources.*/**
**/*.sources.*/**

# Workspace and cache files.
*.code-workspace
__pycache__/**
*.pyc
