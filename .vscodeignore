# Local state, private notes, generated archives, and package artifacts.
.gitignore
exts.txt
.harmony/**
.harmony-archive/**
.harmony.bak/**
.harmony-staging/**
.harmony-repair/**
.fastembed_cache/**
**/*.md
!README.md
# docs/: ship the repair guide and provider-model discovery guide
docs/*.md
!docs/LIFELINE.md
!docs/LIFELINE.zh-CN.md
!docs/provider-model-discovery.md
docs/primitives/**
docs/test.pdf
test/*.pdf
out/*.md
_*/**
*.zip
*.vsix
*.vsix.bak
$null
_test_extract*/**
_extract_*/**
_temp_extract_*/**

# Secrets and local config.
.env
.env.*
*.env
*.key
*.pem
*.pfx
*.p12
*.crt
*.cer

# Local development folders.
.carebloom/
.harmonyhub-test/
extension/
.github/

# Generated dependencies/build outputs.
companion-extensions/**
native-ui/node_modules/**
native-ui/dist/**
native-ui/src-tauri/target/**

# Native build artifacts and source that should never ship in the VSIX.
**/*.pdb
**/*.iobj
**/*.ipdb
**/*.obj
**/*.lib
**/*.exp
**/*.map
node_modules/better-sqlite3/deps/**
node_modules/duckdb/src/**

# Backups should never ship.
_*.js
*.backup*
**/*.backup*
__pycache__/**  
*.pyc  
