# Local state, generated archives, and package artifacts.
.gitignore
# Console-redirect artifacts some tooling leaves in the workspace root
# (e.g. "code --list-extensions > exts.txt", or "> $null" under cmd.exe).
exts.txt
$null
.harmony/**
.harmony-archive/**
.harmony.bak/**
.harmony-staging/**
.harmony-repair/**
.fastembed_cache/**
**/*.md
!README.md
!README.zh-CN.md
# docs/: ship the repair guide and provider-model discovery guide
docs/*.md
!docs/LIFELINE.md
!docs/LIFELINE.zh-CN.md
!docs/provider-model-discovery.md
docs/primitives/**
docs/test.pdf
test/*.pdf
out/*.md
_*/**
*_000/
*.zip
*.vsix
*.vsix.bak
_test_extract*/**
_extract_*/**
_temp_extract_*/**

# Secrets and local config.
.env
.env.*
*.env
*.key
*.pem
*.pfx
*.p12
*.crt
*.cer

# Local development folders.
extension/
.github/

# Dev/test scripts and specs (not shipped in the extension).
scripts/**
spec/**

# Generated dependencies/build outputs.
companion-extensions/**
native-ui/node_modules/**
native-ui/dist/**
native-ui/src-tauri/target/**

# Native build artifacts and source that should never ship in the VSIX.
**/*.pdb
**/*.iobj
**/*.ipdb
**/*.obj
**/*.lib
**/*.exp
**/*.map
node_modules/better-sqlite3/deps/**
node_modules/duckdb/src/**

# Backups should never ship.
_*.js
*.backup*
**/*.backup*

# Editor workspace files can embed absolute local paths.
*.code-workspace
__pycache__/**  
*.pyc  
