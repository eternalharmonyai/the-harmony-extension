# ─────────────────────────────────────────────────────────────────────────────
# Harmony Extension — Provider API Keys (TEMPLATE)
#
# Copy this file to `.env` in your workspace root, fill in your keys, then run
# "Harmony: Import Provider Keys From .env" from the Command Palette.
#
# ⚠️ Never commit a real `.env` — it holds live secrets and is gitignored.
# This `env.example` contains variable NAMES only and is safe to commit.
#
# "Coding" provider variants (Zhipu Coding, Doubao Coding, BytePlus Coding,
# Doubao Rewards) share their parent's keys — they only switch the endpoint
# Harmony calls. Choose the endpoint inside Harmony (sidebar → endpoint
# profile), not here.
# ─────────────────────────────────────────────────────────────────────────────

# ── DeepSeek ────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_AGENT_API_KEY=
DEEPSEEK_EXTERNAL_API_KEY=
# DEEPSEEK_COPILOT_API_KEY=   # optional: for the Copilot-dropdown route

# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Anthropic (Claude) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Google Gemini ───────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── OpenRouter ──────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=

# ── Alibaba / Qwen (DashScope) ──────────────────────────────────────────────
ALIBABA_API_KEY=
ALIBABA_AGENT_API_KEY=
ALIBABA_EXTERNAL_API_KEY=
ALIBABA_VISION_API_KEY=

# ── Moonshot / Kimi ─────────────────────────────────────────────────────────
MOONSHOT_API_KEY=
MOONSHOT_AGENT_API_KEY=
MOONSHOT_EXTERNAL_API_KEY=

# ── KimiCode ────────────────────────────────────────────────────────────────
KIMICODE_API_KEY=
KIMICODE_AGENT_API_KEY=
KIMICODE_EXTERNAL_API_KEY=

# ── Zhipu (Z.AI / GLM) ──────────────────────────────────────────────────────
# Zhipu Coding (the Z.AI coding plan) shares these same keys — it only uses a
# different endpoint. Select the endpoint in Harmony, not here.
Z_API_KEY=
Z_AGENT_API_KEY=
Z_VISION_API_KEY=
Z_EXTERNAL_API_KEY=

# ── Tencent / Hunyuan ───────────────────────────────────────────────────────
# Native dual-auth uses SecretId + SecretKey. Set TENCENT_API_KEY instead to use
# the OpenAI-compatible route.
TENCENT_SecretID=
TENCENT_SecretKey=
TENCENT_AGENT_SecretId=
TENCENT_AGENT_SecretKey=

# ── Doubao / Volcengine (ByteDance) ─────────────────────────────────────────
# Doubao Coding and Doubao Rewards share these keys — endpoint is selected
# inside Harmony.
VOLCENGINE_API_KEY=
VOLCENGINE_AGENT_API_KEY=
VOLCENGINE_VISION_API_KEY=
VOLCENGINE_EXTERNAL_API_KEY=

# ── BytePlus ────────────────────────────────────────────────────────────────
# BytePlus Coding shares these keys — endpoint is selected inside Harmony.
BYTEPLUS_API_KEY=
BYTEPLUS_AGENT_API_KEY=
BYTEPLUS_EXTERNAL_API_KEY=

# ── StepFun (Jieyue Xingchen) ───────────────────────────────────────────────
STEPFUN_API_KEY=
STEPFUN_AGENT_API_KEY=
STEPFUN_EXTERNAL_API_KEY=
